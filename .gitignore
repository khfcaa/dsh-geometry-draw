# 依赖与锁文件（本插件在 DSH 里以 file:/link: 方式安装，仓库不锁定依赖树）
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock
.npm/

# 测试与演示的产物（重新生成即可，不进版本库）
tests/out/
tests/demo/
coverage/
*.tsbuildinfo

# 编辑器与系统垃圾
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
tmp/

# 只属于本机维护流程的脚本（含本机绝对路径，不进公开仓库）
_private/
